{
  "name": "pubchat",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "headers:check": "node scripts/check-security-headers.mjs https://pubchat.org",
    "cf:security:list": "node scripts/cf-apply-security-rules.mjs --list",
    "cf:security:plan": "node scripts/cf-apply-security-rules.mjs",
    "cf:security:apply": "node scripts/cf-apply-security-rules.mjs --apply",
    "perf:tail": "wrangler tail pubchat --format pretty --search \"[perf]\"",
    "test": "vitest",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.6.0",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.87.0"
  },
  "dependencies": {
    "@atproto/api": "^0.19.11"
  }
}
