{
  "name": "pubchat",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-02",
  "routes": [
    { "pattern": "pubchat.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ANCHOR_GATE",
        "class_name": "AnchorGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AnchorGate"]
    }
  ]
}
